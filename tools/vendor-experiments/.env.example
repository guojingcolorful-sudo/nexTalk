# Vendor experiment credentials — TEMPLATE ONLY, contains no real keys.
#
# Setup:
#   1. Copy this file to `.env` in the same directory:  cp .env.example .env
#   2. Fill in the keys below.
#   3. `.env` is gitignored — never commit it. If a key is ever committed,
#      treat it as leaked: rotate it in the vendor console FIRST.
#
# The experiment scripts read credentials only from the process environment
# at run time. Load the file before running an experiment:
#
#   set -a; source .env; set +a
#
# ---------------------------------------------------------------------------
# 讯飞开放平台 — 流式语音听写 (WebSocket ASR)
# 控制台 → 我的应用 → 应用详情: APPID / APISecret / APIKey
# ---------------------------------------------------------------------------
XFYUN_APP_ID=""
XFYUN_API_KEY=""
XFYUN_API_SECRET=""

# ---------------------------------------------------------------------------
# DeepSeek — 文本 API（翻译 + Copilot）
# platform.deepseek.com → 左侧 API Keys → 创建
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=""

# ---------------------------------------------------------------------------
# 火山引擎 — 语音技术（声音复刻 / Doubao TTS）
# 火山引擎控制台 → 右上角头像 → API 访问密钥（Access Key / Secret Key）
# 语音技术应用详情里另有 AppID / Access Token（按你开通的接口填写）
# ---------------------------------------------------------------------------
VOLC_ACCESS_KEY=""
VOLC_SECRET_KEY=""
VOLC_APP_ID=""
VOLC_ACCESS_TOKEN=""

# ---------------------------------------------------------------------------
# Deepgram — Nova-3 流式英文 STT
# console.deepgram.com → API Keys
# ---------------------------------------------------------------------------
DEEPGRAM_API_KEY=""

# ---------------------------------------------------------------------------
# MiniMax 国际站 — Speech 2.6 Turbo 克隆 TTS（尚未申请时保持留空）
