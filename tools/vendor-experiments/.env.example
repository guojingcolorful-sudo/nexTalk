# Vendor experiment credentials — TEMPLATE ONLY, contains no real keys.
#
# Setup:
#   1. Copy this file to `.env` in the same directory:  cp .env.example .env
#   2. Fill in the keys below.
#   3. `.env` is gitignored — never commit it. If a key is ever committed,
#      treat it as leaked: rotate it in the vendor console FIRST.
#
# The experiment scripts read credentials only from the process environment
# at run time. Load the file before running an experiment:
#
#   set -a; source .env; set +a
#
# ---------------------------------------------------------------------------
# 讯飞开放平台 — 流式语音听写 (WebSocket ASR)
# 控制台 → 我的应用 → 应用详情: APPID / APISecret / APIKey
# ---------------------------------------------------------------------------
XFYUN_APP_ID=""
XFYUN_API_KEY=""
XFYUN_API_SECRET=""

# ---------------------------------------------------------------------------
# DeepSeek — 文本 API（翻译 + Copilot）
# platform.deepseek.com → 左侧 API Keys → 创建
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=""

# ---------------------------------------------------------------------------
# ---- 火山引擎：声音复刻（已开通；Resource-Id: volc.megatts.voiceclone）----
# 用于克隆音色盲听测试与后续 TTS 克隆管线
VOLC_CLONE_APP_ID=""
VOLC_CLONE_ACCESS_TOKEN=""
# AK/SK（若声音复刻控制台提供；部分接口用 appid+token 即可，AK/SK 可留空）
VOLC_ACCESS_KEY=""
VOLC_SECRET_KEY=""

# ---- 火山引擎：通用 TTS（豆包语音合成大模型 2.0，Seed-TTS 2.0，已开通）----
# 实测可用（2026-09-29）：wss://openspeech.bytedance.com/api/v3/tts/unidirectional/stream
# 握手头：X-Api-Key: {VOLC_TTS_ACCESS_TOKEN} + X-Api-Resource-Id: seed-tts-2.0 + X-Api-Request-Id: uuid
# 音色 2.0 后缀 _uranus_bigtts（如 zh_female_vv_uranus_bigtts）
VOLC_TTS_APP_ID=""
VOLC_TTS_ACCESS_TOKEN=""
# 可选：音色 ID 覆盖
# VOLC_TTS_VOICE="zh_female_vv_uranus_bigtts"

# ---------------------------------------------------------------------------
# Deepgram — Nova-3 流式英文 STT
# console.deepgram.com → API Keys
# ---------------------------------------------------------------------------
DEEPGRAM_API_KEY=""

# ---------------------------------------------------------------------------
# MiniMax 国际站 — Speech 2.6 Turbo 克隆 TTS（尚未申请时保持留空）
